@startuml

class User {
  -id: UUID
  -email: String
  -password: String
  -phone: String
  -fio: String
  -passportData: String
  +login(): Token
  +register(): User
  +updateProfile(): void
}

class Passenger {
  -id: UUID
  -userId: UUID
  -fio: String
  -passportNumber: String
  -birthDate: Date
  +create(): Passenger
  +update(): void
}

class Route {
  -id: UUID
  -trainNumber: String
  -departure: Station
  -arrival: Station
  -departureTime: DateTime
  -arrivalTime: DateTime
  -duration: Duration
  +search(): List<Route>
  +getAvailableSeats(): List<Seat>
}

class Train {
  -id: UUID
  -number: String
  -type: TrainType
  -wagons: List<Wagon>
  +getWagons(): List<Wagon>
}

class Wagon {
  -id: UUID
  -number: int
  -type: WagonType
  -seats: List<Seat>
  +getAvailableSeats(): List<Seat>
}

class Seat {
  -id: UUID
  -number: int
  -wagonId: UUID
  -status: SeatStatus
  -price: Decimal
  +reserve(): void
  +release(): void
}

class Booking {
  -id: UUID
  -userId: UUID
  -routeId: UUID
  -passengers: List<Passenger>
  -seats: List<Seat>
  -totalPrice: Decimal
  -status: BookingStatus
  -createdAt: DateTime
  +create(): Booking
  +cancel(): void
  +confirm(): void
}

class Payment {
  -id: UUID
  -bookingId: UUID
  -amount: Decimal
  -status: PaymentStatus
  -method: PaymentMethod
  -transactionId: String
  +process(): PaymentResult
  +refund(): void
}

class Ticket {
  -id: UUID
  -bookingId: UUID
  -passengerId: UUID
  -seatId: UUID
  -ticketNumber: String
  -qrCode: String
  +generate(): Ticket
  +send(): void
}

User "1" -- "0..*" Passenger
User "1" -- "0..*" Booking
Route "1" -- "1" Train
Train "1" -- "1..*" Wagon
Wagon "1" -- "1..*" Seat
Booking "1" -- "1..*" Passenger
Booking "1" -- "1..*" Seat
Booking "1" -- "1" Payment
Booking "1" -- "1..*" Ticket

@enduml

