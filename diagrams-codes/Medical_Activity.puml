@startuml

start

:Пациент заходит в систему;

if (Авторизован?) then (Нет)
  :Ввод email и пароля;
  :Проверка JWT токена;
  if (Токен валиден?) then (Нет)
    :Ошибка авторизации;
    stop
  else (Да)
    :Успешная авторизация;
  endif
else (Да)
  :Токен действителен;
endif

:Выбор типа диагностики;

fork
  :Загрузка медицинского изображения;
  :Валидация формата (JPEG/PNG);
  if (Формат корректен?) then (Нет)
    :Ошибка: неверный формат;
    stop
  else (Да)
    :Проверка размера ≤10MB;
    if (Размер корректен?) then (Нет)
      :Ошибка: файл слишком большой;
      stop
    else (Да)
      :Сохранение в AWS S3;
      :Сохранение метаданных в PostgreSQL;
    endif
  endif
fork again
  :Ввод текстовых симптомов;
  :Валидация длины ≤1000 символов;
  if (Длина корректна?) then (Нет)
    :Ошибка: текст слишком длинный;
    stop
  else (Да)
    :Сохранение симптомов в PostgreSQL;
  endif
end fork

:Отправка задачи в RabbitMQ;

:Препроцессинг данных;

fork
  :Загрузка изображения из S3;
  :Декодирование через OpenCV;
  :Изменение размера до 224x224;
  :Нормализация ImageNet;
  :Преобразование в тензор float32;
fork again
  :Токенизация текста через BERT;
  :Создание input_ids и attention_mask;
  :Padding до 128 tokens;
end fork

:ИИ-анализ через GPU кластер;

fork
  :Классификация изображения через ResNet-50;
  :Получение вероятностей (softmax);
  :Генерация Grad-CAM heatmap;
fork again
  :Анализ текста через BERT;
  :Получение вероятностей диагнозов;
  :Генерация SHAP объяснений;
end fork

:Объединение результатов;
:Выбор топ-3 диагнозов;

:Сохранение результатов в Redis (TTL=1h);
:Сохранение в PostgreSQL;

:Формирование отчёта;

fork
  :Генерация PDF через PDFKit;
  :Вставка Grad-CAM и результатов;
fork again
  :Генерация HTML через Jinja2;
  :Responsive дизайн Bootstrap 5;
end fork

:Отправка уведомления через WebSocket;

if (Интеграция с MIS включена?) then (Да)
  :Отправка отчёта в Clinic MIS через REST API;
  :Retry 3 раза при ошибке;
endif

:Пациент получает результаты;

stop

@enduml

