<mxfile host="app.diagrams.net">
  <diagram name="DFD P4 Декомпозиция" id="dfd-p4-decomposition">
    <mxGraphModel dx="1800" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <!-- Process 4.1: Extract Symptoms -->
        <mxCell id="2" value="4.1&#10;Извлечение&#10;симптомов" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="250" y="350" width="120" height="100" as="geometry" />
        </mxCell>
        
        <!-- Process 4.2: Tokenize Text -->
        <mxCell id="3" value="4.2&#10;Токенизация&#10;текста" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="450" y="350" width="120" height="100" as="geometry" />
        </mxCell>
        
        <!-- Process 4.3: Generate input_ids -->
        <mxCell id="4" value="4.3&#10;Генерация&#10;input_ids" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="650" y="350" width="120" height="100" as="geometry" />
        </mxCell>
        
        <!-- Process 4.4: Generate attention_mask -->
        <mxCell id="5" value="4.4&#10;Генерация&#10;attention_mask" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="850" y="350" width="120" height="100" as="geometry" />
        </mxCell>
        
        <!-- Process 4.5: Combine Tokens -->
        <mxCell id="6" value="4.5&#10;Объединение&#10;токенов" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="1050" y="350" width="120" height="100" as="geometry" />
        </mxCell>
        
        <!-- Data Store: PostgreSQL -->
        <mxCell id="7" value="D1: PostgreSQL (symptoms)" style="shape=partialRectangle;whiteSpace=wrap;html=1;left=0;right=0;fillColor=none;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="250" y="550" width="200" height="40" as="geometry" />
        </mxCell>
        
        <!-- Data Store: Redis -->
        <mxCell id="8" value="D2: Redis (tokenized cache)" style="shape=partialRectangle;whiteSpace=wrap;html=1;left=0;right=0;fillColor=none;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1050" y="550" width="200" height="40" as="geometry" />
        </mxCell>
        
        <!-- External: User Input -->
        <mxCell id="9" value="User" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="370" width="100" height="60" as="geometry" />
        </mxCell>
        
        <!-- External: ML Inference -->
        <mxCell id="10" value="BERT Model" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="1280" y="370" width="100" height="60" as="geometry" />
        </mxCell>
        
        <!-- Flows -->
        <mxCell id="11" value="Текстовые симптомы (JSON)" style="endArrow=classic;html=1;rounded=0;" edge="1" source="9" target="2" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <mxCell id="12" value="Symptoms text" style="endArrow=classic;html=1;rounded=0;" edge="1" source="2" target="3" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <mxCell id="13" value="Tokens list" style="endArrow=classic;html=1;rounded=0;" edge="1" source="3" target="4" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <mxCell id="14" value="input_ids" style="endArrow=classic;html=1;rounded=0;" edge="1" source="4" target="6" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="710" y="320" />
              <mxPoint x="1110" y="320" />
            </Array>
          </mxGeometry>
        </mxCell>
        
        <mxCell id="15" value="Tokens list" style="endArrow=classic;html=1;rounded=0;" edge="1" source="3" target="5" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="510" y="500" />
              <mxPoint x="910" y="500" />
            </Array>
          </mxGeometry>
        </mxCell>
        
        <mxCell id="16" value="attention_mask" style="endArrow=classic;html=1;rounded=0;" edge="1" source="5" target="6" parent="1">
