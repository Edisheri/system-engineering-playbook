        <mxCell id="task-error" value="Ошибка" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFCDD2" vertex="1" parent="pool-system">
          <mxGeometry x="300" y="20" width="100" height="30" as="geometry" />
        </mxCell>
        
        <mxCell id="flow-s1" value="" style="endArrow=classic;html=1;strokeWidth=2" edge="1" parent="pool-system" source="task-s1" target="gateway1">
          <mxGeometry width="50" height="50" relative="1" as="geometry" />
        </mxCell>
        
        <mxCell id="flow-s2" value="Да" style="endArrow=classic;html=1;strokeWidth=2;fontSize=9" edge="1" parent="pool-system" source="gateway1" target="task-s2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <mxCell id="flow-s3" value="Нет" style="endArrow=classic;html=1;strokeWidth=2;dashed=1;strokeColor=#F44336;fontSize=9" edge="1" parent="pool-system" source="gateway1" target="task-error">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <mxCell id="flow-s4" value="" style="endArrow=classic;html=1;strokeWidth=2" edge="1" parent="pool-system" source="task-s2" target="task-s3">
          <mxGeometry width="50" height="50" relative="1" as="geometry" />
        </mxCell>
        
        <mxCell id="flow-s5" value="" style="endArrow=classic;html=1;strokeWidth=2" edge="1" parent="pool-system" source="task-s4" target="task-s5">
          <mxGeometry width="50" height="50" relative="1" as="geometry" />
        </mxCell>
        
        <!-- Pool: Database -->
        <mxCell id="pool-db" value="База данных" style="swimlane;horizontal=1;startSize=40;fillColor=#C5E1A5;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="100" y="450" width="1800" height="120" as="geometry" />
        </mxCell>
        
        <mxCell id="task-db1" value="Сохранение&#10;пользователя" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10" vertex="1" parent="pool-db">
