<mxfile host="app.diagrams.net">
  <diagram name="BPMN Scenario 1" id="bpmn-s1">
    <mxGraphModel dx="1800" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <!-- Pool: Patient -->
        <mxCell id="pool-patient" value="Пациент" style="swimlane;horizontal=1;startSize=40;fillColor=#E3F2FD;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="100" y="100" width="1800" height="150" as="geometry" />
        </mxCell>
        
        <mxCell id="start1" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#4CAF50" vertex="1" parent="pool-patient">
          <mxGeometry x="50" y="60" width="40" height="40" as="geometry" />
        </mxCell>
        
        <mxCell id="task1" value="Заполнение&#10;формы" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10" vertex="1" parent="pool-patient">
          <mxGeometry x="150" y="55" width="100" height="50" as="geometry" />
        </mxCell>
        
        <mxCell id="task2" value="Подтверждение&#10;email" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10" vertex="1" parent="pool-patient">
          <mxGeometry x="550" y="55" width="100" height="50" as="geometry" />
        </mxCell>
        
        <mxCell id="task3" value="Вход в систему" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10" vertex="1" parent="pool-patient">
          <mxGeometry x="1050" y="55" width="100" height="50" as="geometry" />
        </mxCell>
        
        <mxCell id="end1" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#F44336;strokeWidth=3" vertex="1" parent="pool-patient">
          <mxGeometry x="1220" y="60" width="40" height="40" as="geometry" />
        </mxCell>
        
        <mxCell id="flow1-1" value="" style="endArrow=classic;html=1;strokeWidth=2" edge="1" parent="pool-patient" source="start1" target="task1">
          <mxGeometry width="50" height="50" relative="1" as="geometry" />
        </mxCell>
        
        <mxCell id="flow1-2" value="" style="endArrow=classic;html=1;strokeWidth=2" edge="1" parent="pool-patient" source="task1" target="task2">
          <mxGeometry width="50" height="50" relative="1" as="geometry" />
        </mxCell>
        
        <mxCell id="flow1-3" value="" style="endArrow=classic;html=1;strokeWidth=2" edge="1" parent="pool-patient" source="task2" target="task3">
          <mxGeometry width="50" height="50" relative="1" as="geometry" />
        </mxCell>
        
        <mxCell id="flow1-4" value="" style="endArrow=classic;html=1;strokeWidth=2" edge="1" parent="pool-patient" source="task3" target="end1">
          <mxGeometry width="50" height="50" relative="1" as="geometry" />
        </mxCell>
        
        <!-- Pool: System -->
        <mxCell id="pool-system" value="Система" style="swimlane;horizontal=1;startSize=40;fillColor=#FFF9C4;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="100" y="250" width="1800" height="200" as="geometry" />
        </mxCell>
        
        <mxCell id="task-s1" value="Валидация&#10;данных" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10" vertex="1" parent="pool-system">
          <mxGeometry x="150" y="70" width="100" height="50" as="geometry" />
        </mxCell>
        
        <mxCell id="gateway1" value="Данные&#10;корректны?" style="rhombus;whiteSpace=wrap;html=1;fontSize=9;fillColor=#FFEB3B" vertex="1" parent="pool-system">
          <mxGeometry x="310" y="60" width="80" height="70" as="geometry" />
        </mxCell>
        
        <mxCell id="task-s2" value="Создание&#10;аккаунта" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10" vertex="1" parent="pool-system">
          <mxGeometry x="450" y="70" width="100" height="50" as="geometry" />
        </mxCell>
        
        <mxCell id="task-s3" value="Отправка&#10;email" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#90CAF9" vertex="1" parent="pool-system">
          <mxGeometry x="550" y="70" width="100" height="50" as="geometry" />
        </mxCell>
        
        <mxCell id="task-s4" value="Верификация&#10;токена" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10" vertex="1" parent="pool-system">
          <mxGeometry x="750" y="70" width="100" height="50" as="geometry" />
        </mxCell>
        
        <mxCell id="task-s5" value="Генерация JWT" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10" vertex="1" parent="pool-system">
