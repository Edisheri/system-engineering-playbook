        </mxCell>
        
        <!-- Message flows -->
        <mxCell id="msg1" value="" style="endArrow=classic;html=1;strokeWidth=1.5;dashed=1;strokeColor=#2196F3" edge="1" parent="1" source="task-s2" target="task-db1">
          <mxGeometry width="50" height="50" relative="1" as="geometry" />
        </mxCell>
        
        <mxCell id="msg2" value="" style="endArrow=classic;html=1;strokeWidth=1.5;dashed=1;strokeColor=#2196F3" edge="1" parent="1" source="task-s4" target="task-db2">
          <mxGeometry width="50" height="50" relative="1" as="geometry" />
        </mxCell>
        
      </root>
    </mxGraphModel>
  </diagram>
