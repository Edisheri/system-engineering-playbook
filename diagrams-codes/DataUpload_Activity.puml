@startuml
start

:Пациент входит в систему;

:Проверка JWT токена;

if (Токен валиден?) then (Нет)
  :Ошибка аутентификации;
  stop
else (Да)
  :Доступ разрешён;
endif

:Выбор типа данных;

fork
  :Выбор медицинского изображения;
  :Валидация формата (JPEG/PNG);
  if (Формат корректен?) then (Нет)
    :Ошибка: неверный формат;
    stop
  endif
  :Проверка размера ≤10MB;
  if (Размер корректен?) then (Нет)
    :Ошибка: файл слишком большой;
    stop
  endif
fork again
  :Ввод текстовых симптомов;
  :Валидация длины ≤1000 символов;
  if (Длина корректна?) then (Нет)
    :Ошибка: текст слишком длинный;
    stop
  endif
end fork

fork
  :Шифрование AES-256;
  :Сохранение в AWS S3;
fork again
  :Сохранение метаданных в PostgreSQL;
  :INSERT INTO medical_data;
fork again
  :Формирование сообщения JSON;
  :Отправка в RabbitMQ очередь;
end fork

:Rate Limiting проверка
(100 req/min);

if (Лимит превышен?) then (Да)
  :Ошибка 429 Too Many Requests;
  stop
endif

:Возврат 201 Created + fileId;

stop
@enduml