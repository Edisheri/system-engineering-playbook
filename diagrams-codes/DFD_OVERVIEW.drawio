<mxfile host="app.diagrams.net">
  <diagram name="DFD Overview" id="dfd-overview">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <!-- External Entity: Patient -->
        <mxCell id="patient" value="Пациент" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#E3F2FD" vertex="1" parent="1">
          <mxGeometry x="150" y="400" width="120" height="60" as="geometry" />
        </mxCell>
        
        <!-- Process P1: Registration -->
        <mxCell id="p1" value="P1&#10;Регистрация" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#FFF9C4" vertex="1" parent="1">
          <mxGeometry x="400" y="380" width="120" height="100" as="geometry" />
        </mxCell>
        
        <!-- Process P2: Data Upload -->
        <mxCell id="p2" value="P2&#10;Загрузка&#10;данных" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#FFF9C4" vertex="1" parent="1">
          <mxGeometry x="650" y="380" width="120" height="100" as="geometry" />
        </mxCell>
        
        <!-- Process P3: ML Inference -->
        <mxCell id="p3" value="P3&#10;ИИ-анализ" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#FFF9C4" vertex="1" parent="1">
          <mxGeometry x="900" y="380" width="120" height="100" as="geometry" />
        </mxCell>
        
        <!-- Process P4: Report -->
        <mxCell id="p4" value="P4&#10;Формирование&#10;отчёта" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#FFF9C4" vertex="1" parent="1">
          <mxGeometry x="1150" y="380" width="120" height="100" as="geometry" />
        </mxCell>
        
        <!-- Data Store D1: Users DB -->
        <mxCell id="d1" value="D1: Users DB (PostgreSQL)" style="shape=partialRectangle;whiteSpace=wrap;html=1;left=0;right=0;fillColor=none;strokeWidth=2;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="400" y="600" width="220" height="40" as="geometry" />
        </mxCell>
        
        <!-- Data Store D2: Medical Data -->
        <mxCell id="d2" value="D2: Medical Data (S3 + PostgreSQL)" style="shape=partialRectangle;whiteSpace=wrap;html=1;left=0;right=0;fillColor=none;strokeWidth=2;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="600" y="600" width="280" height="40" as="geometry" />
        </mxCell>
        
        <!-- Data Store D3: ML Models -->
        <mxCell id="d3" value="D3: ML Models (MLflow)" style="shape=partialRectangle;whiteSpace=wrap;html=1;left=0;right=0;fillColor=none;strokeWidth=2;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="900" y="600" width="220" height="40" as="geometry" />
        </mxCell>
        
        <!-- Data Store D4: Reports -->
        <mxCell id="d4" value="D4: Reports (S3)" style="shape=partialRectangle;whiteSpace=wrap;html=1;left=0;right=0;fillColor=none;strokeWidth=2;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1150" y="600" width="180" height="40" as="geometry" />
        </mxCell>
        
        <!-- External Entity: Clinic MIS -->
        <mxCell id="mis" value="Clinic MIS" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#E3F2FD" vertex="1" parent="1">
          <mxGeometry x="1430" y="400" width="120" height="60" as="geometry" />
        </mxCell>
        
        <!-- Flows -->
        <mxCell id="flow1" value="Регистрационные данные" style="endArrow=classic;html=1;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="patient" target="p1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <mxCell id="flow2" value="JWT Token" style="endArrow=classic;html=1;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="p1" target="p2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <mxCell id="flow3" value="Файлы + метаданные" style="endArrow=classic;html=1;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="p2" target="p3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <mxCell id="flow4" value="Результаты inference" style="endArrow=classic;html=1;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="p3" target="p4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <mxCell id="flow5" value="PDF отчёт" style="endArrow=classic;html=1;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="p4" target="mis">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <mxCell id="flow6" value="Отчёт" style="endArrow=classic;html=1;strokeWidth=2;fontSize=10;dashed=1;" edge="1" parent="1" source="p4" target="patient">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1210" y="250" />
              <mxPoint x="210" y="250" />
            </Array>
          </mxGeometry>
        </mxCell>
        
        <!-- Data Store connections -->
        <mxCell id="ds1" value="Запись" style="endArrow=classic;html=1;strokeWidth=1.5;fontSize=9;" edge="1" parent="1" source="p1" target="d1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <mxCell id="ds2" value="Запись" style="endArrow=classic;html=1;strokeWidth=1.5;fontSize=9;" edge="1" parent="1" source="p2" target="d2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <mxCell id="ds3" value="Чтение" style="endArrow=classic;html=1;strokeWidth=1.5;fontSize=9;startArrow=classic;startFill=1;" edge="1" parent="1" source="d3" target="p3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <mxCell id="ds4" value="Запись" style="endArrow=classic;html=1;strokeWidth=1.5;fontSize=9;" edge="1" parent="1" source="p4" target="d4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>