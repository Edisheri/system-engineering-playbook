<mxfile host="app.diagrams.net">
  <diagram name="DFD P2 Декомпозиция" id="dfd-p2-decomposition">
    <mxGraphModel dx="1800" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <!-- External Entity: User -->
        <mxCell id="2" value="Пользователь" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="100" y="400" width="120" height="60" as="geometry" />
        </mxCell>
        
        <!-- Process 2.1: Validate File -->
        <mxCell id="3" value="2.1&#10;Валидация&#10;файла" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="350" y="380" width="120" height="100" as="geometry" />
        </mxCell>
        
        <!-- Process 2.2: Upload to S3 -->
        <mxCell id="4" value="2.2&#10;Загрузка&#10;в S3" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="600" y="380" width="120" height="100" as="geometry" />
        </mxCell>
        
        <!-- Process 2.3: Save Metadata -->
        <mxCell id="5" value="2.3&#10;Сохранение&#10;метаданных" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="850" y="380" width="120" height="100" as="geometry" />
        </mxCell>
        
        <!-- Process 2.4: Send to Queue -->
        <mxCell id="6" value="2.4&#10;Отправка&#10;в очередь" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="1100" y="380" width="120" height="100" as="geometry" />
        </mxCell>
        
        <!-- Data Store: S3 Bucket -->
        <mxCell id="7" value="D1: S3 Bucket (medical-images-raw)" style="shape=partialRectangle;whiteSpace=wrap;html=1;left=0;right=0;fillColor=none;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="600" y="600" width="200" height="40" as="geometry" />
        </mxCell>
        
        <!-- Data Store: PostgreSQL -->
        <mxCell id="8" value="D2: PostgreSQL (medical_data)" style="shape=partialRectangle;whiteSpace=wrap;html=1;left=0;right=0;fillColor=none;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="850" y="600" width="200" height="40" as="geometry" />
        </mxCell>
        
        <!-- Data Store: RabbitMQ -->
        <mxCell id="9" value="D3: RabbitMQ (ml_inference)" style="shape=partialRectangle;whiteSpace=wrap;html=1;left=0;right=0;fillColor=none;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1100" y="600" width="200" height="40" as="geometry" />
        </mxCell>
        
        <!-- External Entity: Error Handler -->
        <mxCell id="10" value="Error Handler" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="350" y="150" width="120" height="60" as="geometry" />
        </mxCell>
        
        <!-- Flows -->
        <!-- User to 2.1 -->
        <mxCell id="11" value="Файл + метаданные" style="endArrow=classic;html=1;rounded=0;" edge="1" source="2" target="3" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <!-- 2.1 to 2.2 -->
        <mxCell id="12" value="Валидированный файл" style="endArrow=classic;html=1;rounded=0;" edge="1" source="3" target="4" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <!-- 2.2 to 2.3 -->
        <mxCell id="13" value="S3 URL + fileId" style="endArrow=classic;html=1;rounded=0;" edge="1" source="4" target="5" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <!-- 2.3 to 2.4 -->
        <mxCell id="14" value="Metadata saved" style="endArrow=classic;html=1;rounded=0;" edge="1" source="5" target="6" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <!-- 2.2 to S3 -->
        <mxCell id="15" value="Запись файла" style="endArrow=classic;html=1;rounded=0;" edge="1" source="4" target="7" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <!-- 2.3 to PostgreSQL -->
        <mxCell id="16" value="INSERT metadata" style="endArrow=classic;html=1;rounded=0;" edge="1" source="5" target="8" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <!-- 2.4 to RabbitMQ -->
        <mxCell id="17" value="PUBLISH message" style="endArrow=classic;html=1;rounded=0;" edge="1" source="6" target="9" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <!-- 2.1 to Error Handler (validation error) -->
        <mxCell id="18" value="Ошибка валидации" style="endArrow=classic;html=1;rounded=0;dashed=1;" edge="1" source="3" target="10" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <!-- 2.4 to User (success) -->
        <mxCell id="19" value="201 Created + fileId" style="endArrow=classic;html=1;rounded=0;exitX=0;exitY=0.5;exitDx=0;exitDy=0;" edge="1" source="6" target="2" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1160" y="300" />
              <mxPoint x="160" y="300" />
            </Array>
          </mxGeometry>
        </mxCell>
        
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>

